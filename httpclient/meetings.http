### 2.7 Query Meetings - Combined Filter: Organizer AND Participant (200 OK)
GET http://{{host}}/api/v1/meetings?organizerId=1&participantId=2
Accept: application/json

> {%
    client.test("Status code is 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
%}

### 2.8 Query Meetings - Error: Missing Mandatory Filter Rule (400 Bad Request)
# Calling without organizerId or participantId must be rejected
GET http://{{host}}/api/v1/meetings
Accept: application/json

> {%
    client.test("Status code is 400 Bad Request", function() {
        client.assert(response.status === 400, "Expected 400 when both filters are missing");
    });
    client.test("Problem detail message", function() {
        client.assert(response.body.detail.includes("At least one filter parameter"));
    });
%}

### 2.9 Cancel Meeting - Success (204 No Content)
# Cancels the meeting and releases its consumed slots back to FREE status
DELETE http://{{host}}/api/v1/meetings/{{meetingId}}

> {%
    client.test("Status code is 204 No Content", function() {
        client.assert(response.status === 204, "Expected 204 but got " + response.status);
    });
%}
